{
  "name": "libreludo",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && shx cp build/client/index.html build/client/404.html && node scripts/generate-csp.mjs",
    "build:native": "NATIVE=1 react-router build",
    "cap:sync": "pnpm run build:native && cap sync ios",
    "cap:open": "cap open ios",
    "lint": "eslint .",
    "preview": "wrangler pages dev ./build/client",
    "type-check": "tsc --noEmit --project ./tsconfig.app.json",
    "host": "react-router dev --host",
    "test": "vitest run --reporter verbose",
    "test:watch": "vitest --reporter verbose",
    "test:coverage": "vitest run --coverage"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "^8.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "isbot": "^5.2.1",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "react-toastify": "^11.1.0",
    "react-tooltip": "^5.30.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8.3.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-istanbul": "^4.1.10",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "rollup-plugin-license": "^3.7.1",
    "sharp": "^0.34.5",
    "shx": "^0.4.0",
    "svgo": "^4.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^3.4.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
